# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_IDS=123456789,987654321   # comma-separated Telegram user IDs allowed to use the bot

# GitHub
GITHUB_REPO=owner/repo                     # e.g. myorg/myproject
GITHUB_TOKEN=ghp_your_github_token_here   # needs repo + workflow scopes

# DeepSeek (used for planning and coding)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat               # or deepseek-coder

# Redis (internal — leave as-is when using docker-compose)
REDIS_URL=redis://redis:6379/0

# Git identity for commits
DEVBOT_GIT_EMAIL=devbot@example.com
DEVBOT_GIT_NAME=DevBot

# Repo path inside container (leave as-is)
REPO_PATH=/worktrees/base

# UI validation (optional — only needed for "check staging UI" commands)
STAGING_URL=https://your-staging-url.com
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-2.0-flash
